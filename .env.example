# Everything routes through OpenRouter (one key). OpenRouter reports the real billed cost and
# cached-token counts per call, and passes Anthropic cache_control breakpoints through.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: turns per variant (default 6). Keep small to control spend.
# TURNS=6

# Optional: smoke-test a single model first, e.g. ONLY=openai (keys: openai | anthropic | gemini)
# ONLY=openai
